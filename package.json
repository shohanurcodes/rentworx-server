{
  "name": "rentworx-server",
  "version": "0.1.0",
  "private": true,
  "description": "Express API for the RentWorx equipment rental platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seed.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "mongoose": "^9.12.2",
    "node-cron": "^4.2.1",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
