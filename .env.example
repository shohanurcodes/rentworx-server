# ------------------------------------------------------------------
# Server environment template — copy to .env
# Never expose these values to the client.
# ------------------------------------------------------------------

PORT=5000
NODE_ENV=development

# Same MongoDB Atlas database used by BetterAuth.
MONGODB_URI=

# Comma-separated allowed frontend origins.
CLIENT_URL=http://localhost:3000

# BetterAuth JWT verification. These must point to the deployed client.
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000

# Stripe test keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# imgbb key is kept server-side and proxied through /api/upload/imgbb.
IMGBB_API_KEY=

# Seeded accounts.
ADMIN_EMAIL=admin@rentworx.test
ADMIN_PASSWORD=Admin123
OWNER_EMAIL=owner@rentworx.test
OWNER_PASSWORD=Owner123
